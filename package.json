{
  "name": "clipper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.10",
  "engines": {
    "node": "26.13.1",
    "npm": "10.9.10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "test": "vitest run src",
    "test:ui": "playwright test",
    "typecheck": "npm run lint:typed -- --type-check",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests .storybook *.ts",
    "lint:typed": "npm run lint -- --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check && node -e 'const s=require(\"node:fs\").readFileSync(\"package-lock.json\",\"utf8\"); if(s!==JSON.stringify(JSON.parse(s),null,2)+\"\\n\")throw Error(\"package-lock.json must use npm JSON layout\")'",
    "check:deadcode": "fallow dead-code --fail-on-issues",
    "check:code": "fallow --ci --health-baseline .fallow-health-baseline.json --baseline-mode identity --fail-on-stale-baseline",
    "prepare": "lefthook install",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.8"
  },
  "dependencies": {
    "@remotion/player": "^4.0.543",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fallow": "3.43.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "storybook": "^10.6.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
