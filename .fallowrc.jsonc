{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/main.tsx"],
  // The skin's runtime and CSS are registry output, not Clipper code.
  "ignorePatterns": [".storybook/**", "src/lib/**", "src/components/ui/hardware/**"],
  "audit": { "healthBaseline": ".fallow-health-baseline.json" },
  // This absolute URL is fetched by Chromium inside page.evaluate, not resolved by Node.
  "ignoreUnresolvedImports": ["/node_modules/mediabunny/dist/bundles/mediabunny.mjs"],
}
